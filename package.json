{
  "name": "pair-wise-gsb-71",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:engine": "tsc -p test-engine/tsconfig.json && node -e \"require('fs').writeFileSync('.engine-dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node .engine-dist/test-engine/engine.test.js",
    "test:e2e": "esbuild test-engine/adapter.e2e.ts --bundle --platform=node --format=cjs --outfile=.engine-dist/adapter.e2e.cjs --alias:@=./src --log-level=warning && node .engine-dist/adapter.e2e.cjs",
    "test": "npm run test:engine && npm run test:e2e"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tanstack/vue-query": "^5.66.0",
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
